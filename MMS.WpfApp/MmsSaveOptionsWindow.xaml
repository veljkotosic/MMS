<Window x:Class="MMS.WpfApp.MmsSaveOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MMS Save Options" Height="320" Width="300" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <GroupBox Header="Colorspace" Margin="0,0,0,10">
            <StackPanel Margin="5">
                <RadioButton Content="RGB" IsChecked="{Binding IsRgb}" IsEnabled="{Binding IsNotMpeg1}" Margin="0,2"/>
                <RadioButton Content="YCbCr" IsChecked="{Binding IsYCbCr}" Margin="0,2"/>
                <RadioButton Content="Linear" IsChecked="{Binding IsLinear}" IsEnabled="{Binding IsNotMpeg1}" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Compression" Margin="0,0,0,20">
            <StackPanel Margin="5">
                <RadioButton Content="None" IsChecked="{Binding IsNone}" Margin="0,2"/>
                <RadioButton Content="Shannon-Fano" IsChecked="{Binding IsShannonFano}" IsEnabled="True" Margin="0,2"/>
                <RadioButton Content="MPEG-1" IsChecked="{Binding IsMpeg1}" IsEnabled="True" Margin="0,2"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="75" Margin="0,0,10,0" IsDefault="True" Click="Save_Click"/>
            <Button Content="Cancel" Width="75" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>