<Window x:Class="MMS.WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:MMS.WpfApp.Controls"
        xmlns:viewModels="clr-namespace:MMS.WpfApp.ViewModels"
        mc:Ignorable="d"
        Title="MMS" Height="450" Width="900">
    <Window.InputBindings>
        <KeyBinding Key="Z"
                    Modifiers="Control"
                    Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y"
                    Modifiers="Control"
                    Command="{Binding RedoCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DrawingBrush x:Key="CheckeredBrush"
                      Viewport="0,0,20,20"
                      ViewportUnits="Absolute"
                      TileMode="Tile">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,20,20" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#E0E0E0">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,10,10" />
                                <RectangleGeometry Rect="10,10,10,10" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="6" />
            <RowDefinition Height="130" MinHeight="80" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_Load Image" Command="{Binding LoadCommand}" />
                <MenuItem Header="_Save Image As" Command="{Binding SaveAsCommand}" />
                <Separator />
                <MenuItem Header="_Close Image" Command="{Binding CloseCommand}" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo"
                          Command="{Binding UndoCommand}"
                          InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo"
                          Command="{Binding RedoCommand}"
                          InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Center Image" Command="{Binding CenterImageCommand}" CommandParameter="{Binding ElementName=Border}" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" MaxWidth="520" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="250" MinWidth="200" MaxWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F3F3F3"
                    BorderBrush="#D2D2D2"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="History"
                               FontWeight="SemiBold"
                               Margin="10,10,10,6" />

                    <ListBox x:Name="HistoryList"
                             Grid.Row="1"
                             ItemsSource="{Binding HistoryListings}"
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:HistoryListingViewModel}">
                                <Border Margin="8,0,8,8"
                                        Padding="10,8"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Background="White"
                                        BorderBrush="#D4D4D4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#2F6FED" />
                                                    <Setter Property="Background" Value="#F7FAFF" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBatch}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Expander Header="{Binding Title}"
                                                  IsExpanded="False"
                                                  FontWeight="SemiBold">
                                            <Expander.Style>
                                                <Style TargetType="Expander">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBatch}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Expander.Style>
                                            <ItemsControl ItemsSource="{Binding Details}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}"
                                                                   FontSize="12"
                                                                   FontWeight="Normal"
                                                                   Foreground="#666666"
                                                                   TextWrapping="NoWrap"
                                                                   Margin="18,4,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#E7E7E7"
                          BorderBrush="#9A9A9A"
                          BorderThickness="1,0"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Grid Grid.Column="2" ClipToBounds="True">
                <controls:ZoomBorder x:Name="Border" Background="{StaticResource CheckeredBrush}">
                    <Image Source="{Binding MainImage}" Stretch="Uniform" />
                </controls:ZoomBorder>
            </Grid>

            <GridSplitter Grid.Column="3"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#E7E7E7"
                          BorderBrush="#9A9A9A"
                          BorderThickness="1,0"
                          Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          ShowsPreview="True" />

            <Border Grid.Column="4"
                    Background="#F3F3F3"
                    BorderBrush="#D2D2D2"
                    BorderThickness="1,0,0,0">
                <controls:FilterStagingView DataContext="{Binding FilterStaging}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2"
                      Height="6"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#E7E7E7"
                      BorderBrush="#9A9A9A"
                      BorderThickness="0,1"
                      Cursor="SizeNS"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      ShowsPreview="True" />

        <Border Grid.Row="3"
                Background="#F3F3F3"
                BorderBrush="#D2D2D2"
                BorderThickness="0,1,0,0"
                Padding="10,6,10,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Log"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding ClientLogs}"
                         Background="White"
                         BorderBrush="#D2D2D2"
                         BorderThickness="1"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:ClientLogEntry}">
                            <Grid Margin="6,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                           Foreground="#666666"
                                           FontFamily="Consolas" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           Foreground="#333333" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
